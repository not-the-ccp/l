#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$HERE/build/lsyntax" ] || [ "$HERE/tools/syntax/lsyntax.l" -nt "$HERE/build/lsyntax" ] || [ "$HERE/lib/core/slang_syntax.l" -nt "$HERE/build/lsyntax" ] || [ "$HERE/lib/core/slang_index.l" -nt "$HERE/build/lsyntax" ] || [ "$HERE/src/vm/native_vm.c" -nt "$HERE/build/lsyntax" ]; then
  "$HERE/scripts/build.sh" lsyntax >/dev/null
fi
exec "$HERE/build/lsyntax" "$@"
