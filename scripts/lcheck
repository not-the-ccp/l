#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$HERE/build/lcheck" ] || [ "$HERE/tools/check/lcheck.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/core/slang_check.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/core/slang_names.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/core/slang_types.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/core/slang_decls.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/core/slang_syntax.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/src/vm/native_vm.c" -nt "$HERE/build/lcheck" ]; then
  "$HERE/scripts/build.sh" lcheck >/dev/null
fi
exec "$HERE/build/lcheck" "$@"
