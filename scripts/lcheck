#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$HERE/build/lcheck" ] || [ "$HERE/tools/check/lcheck.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/slang/check.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/slang/names.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/slang/types.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/slang/decls.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/lib/slang/syntax.l" -nt "$HERE/build/lcheck" ] || [ "$HERE/src/vm/vm.c" -nt "$HERE/build/lcheck" ]; then
  "$HERE/scripts/build.sh" lcheck >/dev/null
fi
exec "$HERE/build/lcheck" "$@"
