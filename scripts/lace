#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUT="$HERE/build/lace"
needs_build=false
if [ ! -x "$OUT" ]; then
  needs_build=true
elif [ "$HERE/src/vm/native_vm.c" -nt "$OUT" ] || [ "$HERE/scripts/build.sh" -nt "$OUT" ]; then
  needs_build=true
elif find "$HERE/tools/lace2" "$HERE/lib/portable" -type f -name '*.l' -newer "$OUT" -print -quit | grep -q .; then
  needs_build=true
fi
if [ "$needs_build" = true ]; then
  "$HERE/scripts/build.sh" lace >/dev/null
fi
exec "$OUT" "$@"
