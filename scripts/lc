#!/usr/bin/env python3
"""L bootstrap compiler: checked L source to a native executable.

Usage:
    scripts/lc SOURCE [-o OUTPUT] [--root DIR] [--emit-c FILE] [--check]
    scripts/lc analyze SOURCE [options]
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

# Never write __pycache__ into the source tree; keep bytecode in memory.
sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE / "src"))

if len(sys.argv) > 1 and sys.argv[1] == "analyze":
    from lang.analyze import main as analyze_main

    raise SystemExit(analyze_main(sys.argv[2:]))

from lang import LangError
from lang.atomic_output import publish_after_success
from lang.cli_common import VERSION, emit_lang_error
from tools.native_compile import build_user, compile_native


def parser() -> argparse.ArgumentParser:
    """Build the lc argument parser."""
    p = argparse.ArgumentParser(
        prog="./lc",
        description="L bootstrap compiler — checked L -> native executable",
        epilog="source analysis: ./lc analyze SOURCE [options]",
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"lc {VERSION} (Python-bootstrap frontend)",
    )
    p.add_argument("source", nargs="?")
    p.add_argument("-o", "--output")
    p.add_argument("--root")
    p.add_argument("--emit-c")
    p.add_argument(
        "--check", action="store_true", help="parse, link, and type-check only"
    )
    p.add_argument("--cc", default=os.environ.get("CC", "cc"))
    return p


def main() -> int:
    """Compile an L source file to a native executable."""
    ns = parser().parse_args()
    if not ns.source:
        parser().error("source is required")
    src = Path(ns.source).resolve()
    out = Path(ns.output).resolve() if ns.output else src.with_suffix("")
    try:
        program, entry = build_user(
            src, Path(ns.root).resolve() if ns.root else None
        )
        if ns.check:
            print(f"{src}: ok")
            return 0
        emit_c = Path(ns.emit_c).resolve() if ns.emit_c else None
        publish_after_success(
            out, lambda staged: compile_native(program, entry, staged, emit_c, ns.cc)
        )
    except LangError as e:
        emit_lang_error(e, src)
        return 1
    except subprocess.CalledProcessError as e:
        print(
            f"C compiler failed with status {e.returncode}", file=sys.stderr
        )
        return e.returncode
    print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
