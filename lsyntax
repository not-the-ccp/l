#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$HERE/build/lsyntax" ] || [ "$HERE/tools/syntax/lsyntax.l" -nt "$HERE/build/lsyntax" ] || [ "$HERE/lib/portable/slang_syntax.l" -nt "$HERE/build/lsyntax" ] || [ "$HERE/runtime/native_vm.c" -nt "$HERE/build/lsyntax" ]; then
  "$HERE/build.sh" lsyntax >/dev/null
fi
exec "$HERE/build/lsyntax" "$@"
